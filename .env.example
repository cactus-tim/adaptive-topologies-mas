# PostgreSQL — credentials for the `postgres` service in docker-compose.yml.
# In local dev these are placeholders; production sets real secrets via the deployment env.
POSTGRES_USER=atm
POSTGRES_PASSWORD=atm
POSTGRES_DB=atm
PG_PORT=5432

# Database DSN for SQLAlchemy async engines (asyncpg driver).
# Note: format is SQLAlchemy-specific (postgresql+asyncpg://).
# For plain psql / psycopg: postgresql://atm:atm@localhost:5432/atm
PG_DSN=postgresql+asyncpg://atm:atm@localhost:5432/atm

# Parquet / bulk storage root (ParquetWriter, reproducibility bundles — added in M3+).
DATA_DIR=./data

# LLM provider API keys (filled in for M2+). Leave blank if not needed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Cerebras Cloud API key — obtain at https://cloud.cerebras.ai/settings/api-keys
CEREBRAS_API_KEY=

# Streamlit HITL UI (M14 — docker compose --profile ui up).
# ATM_PG_DSN is the async DSN used by the UI container to reach Postgres.
# Use the docker-compose service hostname "postgres" inside the container network.
ATM_PG_DSN=postgresql+asyncpg://atm:atm@postgres:5432/atm
# Shared secret for participant login (leave blank to run in dev/no-auth mode).
ATM_UI_SECRET=
# Port the Streamlit server listens on (default 8501).
ATM_UI_PORT=8501
